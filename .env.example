PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/home_care_api
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1h

# Comma-separated list of allowed CORS origins (no spaces needed, they're trimmed)
FRONTEND_ORIGIN=http://localhost:5173,https://your-app.vercel.app

# Number of reverse proxies in front of the API (e.g. 1). Set this on a server
# behind nginx/Traefik/a load balancer, or the login rate limit will treat all
# users as one client. Leave unset when the API is reached directly.
# TRUST_PROXY=1

# Users created on start: with NODE_ENV=production (the docker-compose default)
# the accounts in db/seed-users.js, only on a fresh database; otherwise the dev
# test accounts. Optional recovery override: set these to create (or reset the
# password of) this one Admin on every start.
# SEED_ADMIN_EMAIL=admin@yourdomain.org
# SEED_ADMIN_NAME=System Admin
# SEED_ADMIN_PASSWORD=choose-a-strong-password

# Used by docker-compose.yml when running via Docker on the VPS
POSTGRES_PASSWORD=change-this-to-a-long-random-string
POSTGRES_DB=home_care_api

# Where Media & Evidence uploads are stored (docker-compose mounts a volume at
# /app/uploads). Behind nginx, raise client_max_body_size to at least 100m or
# video uploads will be rejected before reaching the API.
# UPLOAD_DIR=./uploads

# Days a deleted visit (and its files) can still be restored by an Admin
# before it's removed for good. Default 30.
# VISIT_TRASH_RETENTION_DAYS=30
